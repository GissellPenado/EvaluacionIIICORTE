<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.2">

    <persistence-unit name="laboratorioPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.tuempresa.evaluacioniiicorte.model.TipoEquipo</class>
        <class>com.tuempresa.evaluacioniiicorte.model.Equipo</class>

        <!-- Evita incorporar las entidades antiguas de libros. -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/bd_laboratorio_orm"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="postgres"/>

            <!-- Las tablas se crean con el script SQL. -->
            <property name="hibernate.hbm2ddl.auto"
                      value="validate"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>
        </properties>
    </persistence-unit>
</persistence>